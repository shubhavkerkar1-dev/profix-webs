rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /qualifications/{userId}/{allPaths=**} {
      // Any authenticated user (admin, customer) can view qualifications
      allow read: if request.auth != null;
      // Only the professional can upload their own qualification documents (< 10MB, images only)
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
